{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimCitationMapV05",
  "type": "object",
  "additionalProperties": false,
  "required": ["citations"],
  "properties": {
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_path", "finding_ids", "claim_status", "explanation"],
        "properties": {
          "claim_path": {
            "type": "string",
            "pattern": "^(user_insight|market_hypothesis|value_proposition)\\."
          },
          "finding_ids": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EV-[0-9]{3}$"}
          },
          "claim_status": {
            "type": "string",
            "enum": ["evidence_backed", "contested", "inference", "unknown"]
          },
          "explanation": {"type": "string", "minLength": 8, "maxLength": 400}
        }
      }
    }
  }
}

