{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValueProposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_value", "functional_values", "emotional_values", "social_values", "positioning_statement", "reasons_to_believe", "message_pillars", "objections", "message_tests", "confidence"],
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^(context|user_insight|market_hypothesis)\\."}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "confidence", "validation_status"],
      "properties": {
        "basis": {"type": "string", "enum": ["explicit_brief", "contextual_inference", "behavioral_hypothesis"]},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "validation_status": {"type": "string", "enum": ["brief_supported", "needs_validation"]}
      }
    },
    "valueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "why_it_matters", "source_refs", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 10},
        "why_it_matters": {"type": "string", "minLength": 10},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  },
  "properties": {
    "primary_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "value_type", "rationale", "source_refs", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 12},
        "value_type": {"type": "string", "enum": ["functional", "emotional", "social"]},
        "rationale": {"type": "string", "minLength": 12},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "functional_values": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/valueItem"}},
    "emotional_values": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/valueItem"}},
    "social_values": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/valueItem"}},
    "positioning_statement": {"type": "string", "minLength": 40},
    "reasons_to_believe": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "support_status", "source_refs"],
        "properties": {
          "capability": {"type": "string", "minLength": 6},
          "support_status": {"type": "string", "enum": ["brief_supported", "needs_confirmation"]},
          "source_refs": {"$ref": "#/$defs/sourceRefs"}
        }
      }
    },
    "message_pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "message", "user_problem", "priority", "source_refs", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "message": {"type": "string", "minLength": 12},
          "user_problem": {"type": "string", "minLength": 10},
          "priority": {"type": "string", "enum": ["primary", "secondary"]},
          "source_refs": {"$ref": "#/$defs/sourceRefs"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "objections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objection", "response_hypothesis", "source_refs", "evidence"],
        "properties": {
          "objection": {"type": "string", "minLength": 8},
          "response_hypothesis": {"type": "string", "minLength": 12},
          "source_refs": {"$ref": "#/$defs/sourceRefs"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "message_tests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["angle", "variant_a", "variant_b", "primary_metric", "expected_learning", "source_refs"],
        "properties": {
          "angle": {"type": "string", "enum": ["feature_led", "pain_led", "scenario_led", "confidence_led", "social_value_led"]},
          "variant_a": {"type": "string", "minLength": 10},
          "variant_b": {"type": "string", "minLength": 10},
          "primary_metric": {"type": "string", "minLength": 3},
          "expected_learning": {"type": "string", "minLength": 12},
          "source_refs": {"$ref": "#/$defs/sourceRefs"}
        }
      }
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  }
}
